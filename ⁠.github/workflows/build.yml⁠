name: Build J2ME JAR

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up Java 8
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: '8'

    - name: Download Wireless Toolkit Stubs
      run: |
        mkdir -p lib
        curl -sL https://raw.githubusercontent.com/microemu/microemu/master/microedition/microedition-midp20/src/main/resources/microedition-midp20.jar -o lib/midp20.jar
        curl -sL https://raw.githubusercontent.com/microemu/microemu/master/microedition/microedition-cldc11/src/main/resources/microedition-cldc11.jar -o lib/cldc11.jar

    - name: Compile Java Code
      run: |
        mkdir -p bin
        javac -source 1.8 -target 1.8 -cp "lib/midp20.jar:lib/cldc11.jar" -d bin MiniBrowser.java

    - name: Package JAR
      run: |
        jar cvfm MiniBrowser.jar MANIFEST.MF -C bin .

    - name: Upload Build Artifact
      uses: actions/upload-artifact@v4
      with:
        name: MiniBrowser-JAR
        path: MiniBrowser.jar
